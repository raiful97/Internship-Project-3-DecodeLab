-- =========================================
-- Business Question 1
-- Which referral source generated the most orders?
-- =========================================

SELECT
    referral_source,
    COUNT(*) AS orders
FROM orders
GROUP BY referral_source
ORDER BY orders DESC;


-- =========================================
-- Business Question 2
-- Find the Top 5 highest value orders
-- =========================================

SELECT
    order_id,
    customer_id,
    product,
    total_price
FROM orders
ORDER BY total_price DESC
LIMIT 5;


-- =========================================
-- Business Question 3
-- Show customers who used Online payment
-- =========================================

SELECT
    order_id,
    payment_method,
    total_price
FROM orders
WHERE payment_method = 'Online'
ORDER BY total_price DESC;


-- =========================================
-- Business Question 4
-- Calculate Average Order Value (AOV)
-- =========================================

SELECT
    ROUND(AVG(total_price), 2) AS avg_order_value
FROM orders;


-- =========================================
-- Business Question 5
-- Which products generated the highest revenue?
-- =========================================

SELECT
    product,
    ROUND(SUM(total_price), 2) AS revenue
FROM orders
GROUP BY product
ORDER BY revenue DESC;


-- =========================================
-- Business Question 6
-- Count total orders by order status
-- =========================================

SELECT
    order_status,
    COUNT(*) AS total_orders
FROM orders
GROUP BY order_status
ORDER BY total_orders DESC;
